# TTZip Apple Client & Plugin Kit Bazel Build Definitions

load("@rules_apple//apple:macos.bzl", "macos_application")
load("@rules_swift//swift:swift.bzl", "swift_binary", "swift_interop_hint", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "top_level_target", "xcodeproj")

package(default_visibility = ["//visibility:public"])

swift_library(
    name = "TTZipPluginKit",
    srcs = glob(
        [
            "Sources/TTZipPluginKit/*.swift",
            "Sources/TTZipPluginKit/Testing/*.swift",
        ],
        exclude = [
            "Sources/TTZipPluginKit/Package.swift",
            "Sources/TTZipPluginKit/Testing/PluginCLI.swift",
        ],
    ),
    module_name = "TTZipPluginKit",
    visibility = ["//visibility:public"],
    deps = [
        "//infra/ttlog:TTLogKit",
    ],
)

swift_library(
    name = "TTZipUI",
    srcs = glob(["Sources/TTZipUI/**/*.swift"]),
    module_name = "TTZipUI",
    visibility = ["//visibility:public"],
    deps = [
        "//products/ttzip/core:TTZipCore",
    ],
)

swift_library(
    name = "TTZipBenchmarkKit",
    srcs = glob(["Sources/TTZipBenchmarkKit/**/*.swift"]),
    module_name = "TTZipBenchmarkKit",
    visibility = ["//visibility:public"],
    deps = [
        ":TTZipUI",
        "//products/ttzip/core:TTZipCore",
    ],
)

swift_library(
    name = "TTZipFinderSync",
    srcs = glob(["Sources/TTZipFinderSync/**/*.swift"]),
    module_name = "TTZipFinderSync",
    visibility = ["//visibility:public"],
    deps = [
        "//products/ttzip/core:TTZipCore",
    ],
)

swift_library(
    name = "TTZipQuickLook",
    srcs = glob(["Sources/TTZipQuickLook/**/*.swift"]),
    module_name = "TTZipQuickLook",
    visibility = ["//visibility:public"],
    deps = [
        "//products/ttzip/core:TTZipCore",
    ],
)

swift_library(
    name = "TTZipFileProvider",
    srcs = glob(
        ["Sources/TTZipFileProvider/**/*.swift"],
        exclude = [],
    ),
    module_name = "TTZipFileProvider",
    visibility = ["//visibility:public"],
    deps = [
        "//products/ttzip/core:TTZipCore",
    ],
)

cc_library(
    name = "CMPVBridge",
    srcs = ["Sources/CMPVBridge/CMPVBridge.c"],
    hdrs = glob(["Sources/CMPVBridge/include/**/*.h"]),
    aspect_hints = [":cmpvbridge_swift_interop"],
    includes = ["Sources/CMPVBridge/include"],
    linkopts = [
        "-L/opt/homebrew/lib",
        "-lmpv",
        "-Wl,-rpath,/opt/homebrew/lib",
    ],
    tags = ["swift_module=CMPVBridge"],
)

swift_interop_hint(
    name = "cmpvbridge_swift_interop",
    module_map = "Sources/CMPVBridge/include/module.modulemap",
    module_name = "CMPVBridge",
)

swift_library(
    name = "TTZipPreviewKit",
    srcs = glob(["Sources/TTZipPreviewKit/**/*.swift"]),
    module_name = "TTZipPreviewKit",
    visibility = ["//visibility:public"],
    deps = [
        ":CMPVBridge",
        ":TTZipPluginKit",
        ":TTZipUI",
        "//products/ttzip/core:TTZipCore",
    ],
)

swift_library(
    name = "TTZipAppLib",
    srcs = glob(
        ["Sources/TTZipApp/**/*.swift"],
        exclude = [],
    ),
    defines = [
        "GL_SILENCE_DEPRECATION",
        "MAS_BUILD",
    ],
    copts = [
        "-swift-version", "5",
        "-strict-concurrency=minimal",
    ],
    module_name = "TTZipApp",
    visibility = ["//visibility:public"],
    deps = [
        ":CMPVBridge",
        ":TTZipBenchmarkKit",
        ":TTZipPluginKit",
        ":TTZipPreviewKit",
        ":TTZipUI",
        "//infra/ttlog:TTLogKit",
        "//products/ttzip/core:TTZipCore",
    ],
)

macos_application(
    name = "TTZipApp",
    bundle_id = "com.metastudyline.ttzip",
    infoplists = ["Sources/TTZipApp/Info.plist"],
    minimum_os_version = "14.0",
    visibility = ["//visibility:public"],
    deps = [
        ":TTZipAppLib",
    ],
)

swift_binary(
    name = "PluginKitCLI",
    srcs = [
        "Sources/TTZipPluginKit/Testing/PluginCLI.swift",
    ],
    deps = [
        ":TTZipPluginKit",
    ],
)

xcodeproj(
    name = "xcodeproj",
    project_name = "TTZipApple",
    top_level_targets = [
        top_level_target(":TTZipApp", target_environments = ["device"]),
        top_level_target(":PluginKitCLI", target_environments = ["device"]),
    ],
)

